POSTGRES_DB=dockiy-nuxt-betterauth
POSTGRES_USER=dockiy-nuxt-betterauth
POSTGRES_PASSWORD=secret-password
POSTGRES_DOCKER_PORT=5432
NUXT_DATABASE_URL=postgresql://dockiy-nuxt-betterauth:secret-password@localhost:5432/dockiy-nuxt-betterauth
# Generate a separate secret for each environment with: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_URL=http://localhost:3000
# Optional: configure both values to enable Google sign-in.
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_BREVO_API_KEY=xkeysib-secret-key
NUXT_BREVO_SENDER_EMAIL=youremail@domain.com
NUXT_BREVO_SENDER_NAME=DockIY
APP_ENV=local
UMAMI_ENABLED=false
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Coturn: local Compose defaults to loopback-only testing.
# Production requires a separate random secret, a realm (e.g. turn.example.com),
# and the server public IP (or public/private IP mapping if behind NAT).
# Private Nuxt runtimeConfig.turnSecret / turnUrls; the secret also configures coturn.
# Leave both empty to disable TURN in the app.
NUXT_TURN_SECRET=local-turn-secret
NUXT_TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_REALM=localhost
TURN_EXTERNAL_IP=public-server-ip
